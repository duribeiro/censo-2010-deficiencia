# De onde o painel lê os dados do Censo 2010.
# static: conjunto de dados estático embutido no aplicativo. Padrão.
VITE_DATA_SOURCE=static

# sidra: API pública do IBGE (SIDRA). Planejado para a versão 0.0.2.
# Hoje ainda não está implementado: o painel volta para os dados estáticos
# e mostra um aviso na tela.
# VITE_DATA_SOURCE=sidra
